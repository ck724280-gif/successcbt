# PostgreSQL Connection URL (Use pooled connection URL for serverless/Vercel)
# Example: postgresql://user:password@ep-cool-pooler.us-east-1.aws.neon.tech/cbtdb?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cbt_platform?schema=public"

# Direct URL for Prisma Migrations (Non-pooled connection)
# Example: postgresql://user:password@ep-cool-direct.us-east-1.aws.neon.tech/cbtdb?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cbt_platform?schema=public"

# NextAuth Configuration
# Run `openssl rand -base64 32` to generate a strong secret
NEXTAUTH_SECRET="your-super-secret-jwt-key-minimum-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
